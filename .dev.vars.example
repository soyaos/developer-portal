# Local-only Cloudflare runtime bindings. Copy this file to `.dev.vars`, fill
# in development credentials, and never commit that resulting file.

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Generate with: openssl rand -base64 48
# Rotating this value invalidates active local sessions.
SESSION_SECRET=
API_KEY_PEPPER=replace-with-at-least-32-random-bytes

# Optional local validation of the staging-only E2E session route. The route is
# disabled unless DEPLOYMENT_ENV is exactly "staging".
DEPLOYMENT_ENV=development
E2E_BOOTSTRAP_SECRET=
