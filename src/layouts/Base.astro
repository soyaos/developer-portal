---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SoyaOS Developer Portal",
  description = "API Reference, Playground, API Keys, Webhook Debugger and Usage Dashboard for SoyaOS.",
} = Astro.props;

// PUBLIC_ALPHA_MOCK is set by the CI deploy workflow. We default it
// to "true" so local dev also shows the banner; flip the env var to
// "false" (or remove it) once the control plane RPC is wired and the
// portal stops serving mock data — tracked in EPIC 6 (OAuth + control
// plane).
const alphaMock =
  (import.meta.env.PUBLIC_ALPHA_MOCK ?? "true").toLowerCase() !== "false";
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    {alphaMock && (
      <div
        role="alert"
        class="bg-yellow-300 text-yellow-950 border-b border-yellow-500/60"
      >
        <div class="mx-auto max-w-6xl px-6 py-2 text-sm flex items-center justify-between gap-3">
          <span>
            <strong>Alpha preview</strong> · 数据为 mock，正式后端接入跟踪于
            <a
              href="https://linear.app/appforges/project/soyaosconstruction-82e7f1bdd71e"
              class="underline hover:no-underline"
              rel="noopener noreferrer"
              target="_blank">EPIC 6 — OAuth + control plane</a
            >。
          </span>
          <a
            href="https://github.com/soyaos/developer-portal"
            class="underline hover:no-underline whitespace-nowrap"
            rel="noopener noreferrer"
            target="_blank">Source</a
          >
        </div>
      </div>
    )}
    <header class="border-b border-soya-ink/10">
      <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <img src="/logo.jpg" alt="SoyaOS" width="32" height="32" class="inline-block rounded-md" />
          <span>SoyaOS Developer</span>
        </a>
        <nav class="text-sm flex items-center gap-6">
          <a href="/docs" class="hover:text-soya-accent">Docs</a>
          <a href="/api-keys" class="hover:text-soya-accent">API Keys</a>
          <a href="/webhook-debugger" class="hover:text-soya-accent">Webhooks</a>
          <a href="/usage" class="hover:text-soya-accent">Usage</a>
          <a href="/" class="hover:text-soya-accent">Dashboard</a>
          {user ? (
            <div class="flex items-center gap-3">
              <span class="text-xs text-soya-ink/60">@{user.login}</span>
              <form method="post" action="/auth/logout">
                <button
                  type="submit"
                  class="rounded-md border border-soya-ink/15 px-3 py-1.5 hover:border-soya-accent"
                >Sign out</button>
              </form>
            </div>
          ) : (
            <a
              href="/login"
              class="rounded-md border border-soya-ink/15 px-3 py-1.5 hover:border-soya-accent"
              >Sign in</a
            >
          )}
        </nav>
      </div>
    </header>

    <main class="flex-1 mx-auto w-full max-w-6xl px-6 py-10">
      <slot />
    </main>

    <footer class="border-t border-soya-ink/10 text-xs text-soya-ink/60">
      <div class="mx-auto max-w-6xl px-6 py-6 flex flex-wrap items-center justify-between gap-2">
        <span>&copy; 2026 SoyaOS Contributors &middot; MIT</span>
        <span>
          <a href="https://soyaos.ai" class="hover:text-soya-accent">soyaos.ai</a>
          &middot;
          <a href="https://docs.soyaos.ai" class="hover:text-soya-accent">docs.soyaos.ai</a>
        </span>
      </div>
    </footer>
  </body>
</html>
