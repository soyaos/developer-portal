---
import LocaleSwitcher from "../components/LocaleSwitcher.astro";
import {
  getDictionary,
  localizePath,
  LOCALES,
  LOCALE_META,
} from "../lib/i18n";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  path?: string;
  schemaType?: "WebSite" | "WebPage";
}

const locale = Astro.locals.locale;
const dictionary = getDictionary(locale);
const {
  title = dictionary.meta.defaultTitle,
  description = dictionary.meta.defaultDescription,
  noindex = false,
  path = "/",
  schemaType = "WebPage",
} = Astro.props;
const user = Astro.locals.user;
const href = (path: string) => localizePath(locale, path);
const cleanPath = path === "/" ? "" : path.replace(/\/$/, "");
const canonical = `https://developer.soyaos.ai/${locale}${cleanPath}`;
const markdownAlternate = `${canonical}.md`;
const languageAlternates = LOCALES.map((candidate) => ({
  hreflang: LOCALE_META[candidate].htmlLang,
  href: `https://developer.soyaos.ai/${candidate}${cleanPath}`,
}));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  name: title,
  description,
  url: canonical,
  inLanguage: LOCALE_META[locale].htmlLang,
  isPartOf: {
    "@type": "WebSite",
    name: "SoyaOS Developer Portal",
    url: "https://developer.soyaos.ai",
  },
};
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && languageAlternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={`https://developer.soyaos.ai/zh${cleanPath}`} />}
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
    {!noindex && <meta property="og:type" content="website" />}
    {!noindex && <meta property="og:site_name" content="SoyaOS Developer Portal" />}
    {!noindex && <meta property="og:title" content={title} />}
    {!noindex && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    {!noindex && <meta property="og:locale" content={LOCALE_META[locale].ogLocale} />}
    {!noindex && LOCALES.filter((candidate) => candidate !== locale).map((candidate) => (
      <meta property="og:locale:alternate" content={LOCALE_META[candidate].ogLocale} />
    ))}
    {!noindex && <meta name="twitter:card" content="summary" />}
    {!noindex && <meta name="twitter:title" content={title} />}
    {!noindex && <meta name="twitter:description" content={description} />}
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <div class="border-b border-soya-accent/20 bg-soya-accent/[0.07] text-soya-ink">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-6 py-2 text-xs">
        <span><strong>{dictionary.chrome.release}</strong> · {dictionary.chrome.serviceBoundary}</span>
        <a href="https://github.com/soyaos/developer-portal" class="underline hover:no-underline whitespace-nowrap" rel="noopener noreferrer" target="_blank">{dictionary.chrome.source}</a>
      </div>
    </div>
    <header class="border-b border-soya-ink/10">
      <div class="mx-auto max-w-6xl px-6 py-4 flex flex-wrap items-center justify-between gap-4">
        <a href={href("/")} class="flex items-center gap-2 font-semibold tracking-tight">
          <img src="/logo.jpg" alt="SoyaOS" width="32" height="32" class="inline-block rounded-md" />
          <span>SoyaOS Developer</span>
        </a>
        <nav class="text-sm flex flex-wrap items-center justify-end gap-x-5 gap-y-3" aria-label="Primary">
          <a href={href("/docs")} class="hover:text-soya-accent">{dictionary.chrome.nav.docs}</a>
          <a href={href("/api-keys")} class="hover:text-soya-accent">{dictionary.chrome.nav.apiKeys}</a>
          <a href={href("/playground")} class="hover:text-soya-accent">{dictionary.chrome.nav.playground}</a>
          <a href={href("/usage")} class="hover:text-soya-accent">{dictionary.chrome.nav.usage}</a>
          <a href={href("/")} class="hover:text-soya-accent">{dictionary.chrome.nav.dashboard}</a>
          <LocaleSwitcher locale={locale} label={dictionary.chrome.language} />
          {user ? (
            <div class="flex items-center gap-3">
              <span class="text-xs text-soya-ink/60">@{user.login}</span>
              <form method="post" action={`/auth/logout?locale=${locale}`}>
                <button type="submit" class="rounded-md border border-soya-ink/15 px-3 py-1.5 hover:border-soya-accent">{dictionary.chrome.signOut}</button>
              </form>
            </div>
          ) : (
            <a href={href("/login")} class="rounded-md border border-soya-ink/15 px-3 py-1.5 hover:border-soya-accent">{dictionary.chrome.signIn}</a>
          )}
        </nav>
      </div>
    </header>

    <main class="flex-1 mx-auto w-full max-w-6xl px-6 py-10">
      <slot />
    </main>

    <footer class="border-t border-soya-ink/10 text-xs text-soya-ink/60">
      <div class="mx-auto max-w-6xl px-6 py-6 flex flex-wrap items-center justify-between gap-2">
        <span>&copy; 2026 SoyaOS Contributors &middot; MIT</span>
        <span>
          <a href="https://soyaos.ai" class="hover:text-soya-accent">soyaos.ai</a>
          &middot;
          <a href={`https://soyaos.ai/${locale}/docs`} class="hover:text-soya-accent">docs</a>
          &middot;
          <a href={href("/terms")} class="hover:text-soya-accent">{dictionary.chrome.terms}</a>
          &middot;
          <a href={href("/privacy")} class="hover:text-soya-accent">{dictionary.chrome.privacy}</a>
        </span>
      </div>
    </footer>
  </body>
</html>
