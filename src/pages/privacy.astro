---
import Base from "../layouts/Base.astro";
import { getDictionary } from "../lib/i18n";

const page = getDictionary(Astro.locals.locale).privacy;
---

<Base title={page.title} description={page.effective}>
  <article class="max-w-3xl">
    <p class="text-xs uppercase tracking-[0.2em] text-soya-accent">{page.eyebrow}</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">{page.heading}</h1>
    <p class="mt-4 text-sm leading-6 text-soya-ink/70">{page.effective}</p>
    <h2 class="mt-8 text-xl font-semibold">{page.keepsTitle}</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-soya-ink/70">
      {page.keeps.map((item) => <li>{item}</li>)}
    </ul>
    <h2 class="mt-8 text-xl font-semibold">{page.inferenceTitle}</h2>
    <p class="mt-3 text-sm leading-6 text-soya-ink/70">{page.inference}</p>
    <h2 class="mt-8 text-xl font-semibold">{page.locationTitle}</h2>
    <p class="mt-3 text-sm leading-6 text-soya-ink/70">{page.location}</p>
    <p class="mt-8 text-xs text-soya-ink/50">{page.note}</p>
  </article>
</Base>
