---
import Base from "../layouts/Base.astro";
import { UsagePanel } from "../components/UsagePanel";
---

<Base title="Usage · SoyaOS Developer Portal">
  <section class="mb-8">
    <p class="text-xs uppercase tracking-[0.2em] text-soya-accent">Quota</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Usage</h1>
    <p class="mt-2 max-w-2xl text-sm text-soya-ink/70">
      Live daily quota, per-key model usage and request trace metadata for your
      personal tenant. Quotas reset at 00:00 UTC.
    </p>
  </section>

  <UsagePanel client:load />
</Base>
