---
import Base from "../layouts/Base.astro";
import { getDictionary } from "../lib/i18n";

const locale = Astro.locals.locale;
const page = getDictionary(locale).docs;
---

<Base title={page.title} description={page.description} path="/docs">
  <article class="max-w-3xl py-8">
    <h1 class="text-3xl font-semibold tracking-tight">{page.heading}</h1>
    <p class="mt-4 text-sm leading-6 text-soya-ink/70">{page.description}</p>
    <a class="mt-8 inline-flex rounded-md bg-soya-ink px-4 py-2.5 text-sm font-medium text-soya-paper hover:bg-soya-ink/85" href={`https://soyaos.ai/${locale}/docs`}>
      {page.openDocs} &rarr;
    </a>
  </article>
</Base>
