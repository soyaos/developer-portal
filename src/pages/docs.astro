---
import Base from "../layouts/Base.astro";
---

<Base title="Docs · SoyaOS Developer Portal">
  <section class="mb-4">
    <h1 class="text-2xl font-semibold tracking-tight">Documentation</h1>
    <p class="mt-2 text-sm text-soya-ink/70">
      Embedded from <a class="underline hover:text-soya-accent" href="https://docs.soyaos.ai">docs.soyaos.ai</a>.
      If you can&apos;t see the docs below, they&apos;re being prepared — please check back shortly
      or open the link directly.
    </p>
  </section>

  <div class="overflow-hidden rounded-xl border border-soya-ink/10 bg-white/40">
    <iframe
      src="https://docs.soyaos.ai"
      title="SoyaOS Docs"
      loading="lazy"
      class="h-[80vh] w-full"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</Base>
