---
import Base from "../../../layouts/Base.astro";

// Public env var — safe to ship to the client. The client secret stays
// server-side and is only consumed in the callback handler below.
const clientId = import.meta.env.PUBLIC_GITHUB_CLIENT_ID ?? "";

// Build the GitHub authorize URL. We request `read:user` so the control
// plane can attribute API keys / usage to the right human.
//
// TODO(soyaos): `redirect_uri` should be configurable per-environment
// (alpha/staging/prod). For now we point at this app's own callback.
const callbackUrl = new URL("/auth/github/callback", Astro.url).toString();
const state = crypto.randomUUID();
const authorizeUrl = new URL("https://github.com/login/oauth/authorize");
authorizeUrl.searchParams.set("client_id", clientId);
authorizeUrl.searchParams.set("redirect_uri", callbackUrl);
authorizeUrl.searchParams.set("scope", "read:user");
authorizeUrl.searchParams.set("state", state);

// Stash `state` in a short-lived cookie so the callback can verify it.
Astro.cookies.set("soyaos_oauth_state", state, {
  httpOnly: true,
  sameSite: "lax",
  secure: true,
  path: "/",
  maxAge: 600,
});

const clientConfigured = clientId.length > 0;
---

<Base title="Sign in with GitHub · SoyaOS Developer Portal">
  <section class="mx-auto max-w-md py-16 text-center">
    <h1 class="text-2xl font-semibold tracking-tight">Continue with GitHub</h1>
    <p class="mt-3 text-sm text-soya-ink/70">
      You&apos;re about to be redirected to <code>github.com</code> to
      authorize the SoyaOS Developer Portal. We only request the
      <code>read:user</code> scope so we can show your handle in the
      dashboard.
    </p>

    {clientConfigured ? (
      <a
        href={authorizeUrl.toString()}
        class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md bg-soya-ink px-4 py-2.5 text-sm font-medium text-soya-paper transition hover:bg-soya-ink/85 focus:outline-none focus:ring-2 focus:ring-soya-accent"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" class="h-4 w-4 fill-current">
          <path
            fill-rule="evenodd"
            d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        Authorize with GitHub
      </a>
    ) : (
      <div class="mt-8 rounded-md border border-soya-accent/40 bg-soya-accent/10 p-4 text-left text-xs text-soya-ink/80">
        <p class="font-medium">GitHub OAuth not configured</p>
        <p class="mt-1">
          Set <code>PUBLIC_GITHUB_CLIENT_ID</code> (and
          <code>GITHUB_CLIENT_SECRET</code> server-side) in
          <code>.env.local</code> — see <code>.env.example</code> and the
          README&apos;s <em>Auth Setup</em> section.
        </p>
      </div>
    )}

    <p class="mt-6 text-xs text-soya-ink/50">
      OAuth state: <code class="font-mono">{state.slice(0, 8)}…</code>
    </p>
  </section>
</Base>
