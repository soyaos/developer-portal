---
import Base from "../../../layouts/Base.astro";
import { setSession } from "../../../lib/session";

const code = Astro.url.searchParams.get("code") ?? "";
const stateParam = Astro.url.searchParams.get("state") ?? "";
const error = Astro.url.searchParams.get("error") ?? "";

const expectedState = Astro.cookies.get("soyaos_oauth_state")?.value ?? "";
// One-shot — clear regardless of outcome so a leaked state value can't
// be replayed.
Astro.cookies.delete("soyaos_oauth_state", { path: "/" });

type Status =
  | { kind: "error"; message: string }
  | { kind: "ok"; login: string; tokenPreview: string };

let status: Status;

if (error) {
  status = { kind: "error", message: `GitHub returned error: ${error}` };
} else if (!code) {
  status = { kind: "error", message: "Missing ?code in callback URL." };
} else if (!stateParam || stateParam !== expectedState) {
  status = {
    kind: "error",
    message: "OAuth state mismatch — restart the sign-in flow.",
  };
} else {
  // TODO(soyaos): replace this mock exchange with:
  //
  //   const res = await fetch(`${env.CONTROL_PLANE_URL}/control/v0/auth/github/exchange`, {
  //     method: "POST",
  //     headers: { "content-type": "application/json" },
  //     body: JSON.stringify({ code, redirect_uri: callbackUrl }),
  //   });
  //   const { token, login } = await res.json();
  //
  // The control plane is the only thing that should ever see
  // GITHUB_CLIENT_SECRET — we never want the secret on the edge.
  const fakeToken = `soya_dev_${crypto.randomUUID().replace(/-/g, "")}`;
  const fakeLogin = `dev-${code.slice(0, 6)}`;

  setSession(Astro.cookies, {
    token: fakeToken,
    login: fakeLogin,
    issuedAt: new Date().toISOString(),
  });

  status = {
    kind: "ok",
    login: fakeLogin,
    tokenPreview: `${fakeToken.slice(0, 12)}…`,
  };
}
---

<Base title="GitHub Callback · SoyaOS Developer Portal">
  <section class="mx-auto max-w-md py-16">
    {status.kind === "ok" ? (
      <div class="rounded-xl border border-soya-accent/40 bg-soya-accent/5 p-6 text-center">
        <p class="text-xs uppercase tracking-[0.2em] text-soya-accent">
          Signed in
        </p>
        <h1 class="mt-2 text-xl font-semibold tracking-tight">
          Welcome, {status.login}
        </h1>
        <p class="mt-3 text-sm text-soya-ink/70">
          Session cookie issued. Token preview:
          <code class="ml-1 font-mono">{status.tokenPreview}</code>
        </p>
        <div class="mt-6 flex items-center justify-center gap-3">
          <a
            href="/"
            class="rounded-md bg-soya-ink px-4 py-2 text-sm font-medium text-soya-paper hover:bg-soya-ink/85"
          >Go to dashboard</a>
          <a
            href="/api-keys"
            class="rounded-md border border-soya-ink/15 px-4 py-2 text-sm hover:border-soya-accent"
          >Manage API keys</a>
        </div>
      </div>
    ) : (
      <div class="rounded-xl border border-red-400/40 bg-red-50 p-6 text-center">
        <p class="text-xs uppercase tracking-[0.2em] text-red-600">
          Sign-in failed
        </p>
        <h1 class="mt-2 text-xl font-semibold tracking-tight">
          We couldn&apos;t complete the GitHub handshake
        </h1>
        <p class="mt-3 text-sm text-soya-ink/70">{status.message}</p>
        <div class="mt-6">
          <a
            href="/auth/github/start"
            class="rounded-md border border-soya-ink/15 px-4 py-2 text-sm hover:border-soya-accent"
          >Try again</a>
        </div>
      </div>
    )}
  </section>
</Base>
