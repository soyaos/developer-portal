---
import Base from "../layouts/Base.astro";
import { getDictionary, localizePath } from "../lib/i18n";
import { getPublicContent } from "../lib/public-content";

const locale = Astro.locals.locale;
const dictionary = getDictionary(locale);
const content = getPublicContent(locale, "");
---

<Base title={content.title} description={content.description} schemaType={content.schemaType}>
  <section class="py-12">
    <p class="text-xs uppercase tracking-[0.2em] text-soya-accent">{dictionary.home.eyebrow}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">{dictionary.home.title}</h1>
    <p class="mt-4 max-w-2xl text-soya-ink/70">{dictionary.home.description}</p>
  </section>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {dictionary.home.cards.map((card) => (
      <a href={localizePath(locale, card.path)} class="group rounded-xl border border-soya-ink/10 bg-white/40 p-6 transition hover:-translate-y-0.5 hover:border-soya-accent hover:shadow-sm">
        <h2 class="text-lg font-medium tracking-tight">{card.title}</h2>
        <p class="mt-2 text-sm text-soya-ink/70">{card.body}</p>
        <p class="mt-4 text-xs font-medium uppercase tracking-wider text-soya-accent/80 group-hover:text-soya-accent">{dictionary.home.open} &rarr;</p>
      </a>
    ))}
  </section>
</Base>
