---
import Base from "../layouts/Base.astro";

const cards = [
  {
    title: "API Reference",
    body: "OpenAPI + Connect-RPC specs for the control plane and OpenAI-compatible inference surface.",
    href: "/docs",
  },
  {
    title: "Playground",
    body: "Run real text inference against soya:* models and inspect request IDs and token usage.",
    href: "/playground",
  },
  {
    title: "API Keys",
    body: "Create and revoke Preview keys. Raw keys are displayed once and never stored in recoverable form.",
    href: "/api-keys",
    status: "Open",
  },
  {
    title: "Usage Dashboard",
    body: "View real daily quota, per-key usage and 24-hour request trace metadata.",
    href: "/usage",
    status: "Open",
  },
];
---

<Base>
  <section class="py-12">
    <p class="text-xs uppercase tracking-[0.2em] text-soya-accent">v0.2.0 Public Preview</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
      SoyaOS Developer Portal
    </h1>
    <p class="mt-4 max-w-2xl text-soya-ink/70">
      One place to read the API reference, try the playground, manage keys,
      and watch your quota. GitHub sign-in, personal tenants, API keys,
      inference and usage metadata are backed by the live Cloud control plane.
    </p>
  </section>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="group rounded-xl border border-soya-ink/10 bg-white/40 p-6 transition hover:-translate-y-0.5 hover:border-soya-accent hover:shadow-sm"
        >
          <h2 class="text-lg font-medium tracking-tight">{card.title}</h2>
          <p class="mt-2 text-sm text-soya-ink/70">{card.body}</p>
          <p class="mt-4 text-xs font-medium uppercase tracking-wider text-soya-accent/80 group-hover:text-soya-accent">
            {card.status ?? "Open"} &rarr;
          </p>
        </a>
      ))
    }
  </section>
</Base>
