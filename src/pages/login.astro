---
import Base from "../layouts/Base.astro";

const returnTo = Astro.url.searchParams.get("returnTo") ?? "/";
const startUrl = new URL("/auth/github/start", Astro.url);
startUrl.searchParams.set("returnTo", returnTo);
---

<Base title="Sign in · SoyaOS Developer Portal">
  <section class="mx-auto max-w-md py-16 text-center">
    <h1 class="text-2xl font-semibold tracking-tight">Sign in</h1>
    <p class="mt-2 text-sm text-soya-ink/70">
      Continue with GitHub to create your personal Public Preview tenant.
    </p>

    <a
      href={`${startUrl.pathname}${startUrl.search}`}
      class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md bg-soya-ink px-4 py-2.5 text-sm font-medium text-soya-paper transition hover:bg-soya-ink/85 focus:outline-none focus:ring-2 focus:ring-soya-accent"
    >
      <svg
        viewBox="0 0 16 16"
        aria-hidden="true"
        class="h-4 w-4 fill-current"
      >
        <path
          fill-rule="evenodd"
          d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      Continue with GitHub
    </a>

    <p class="mt-6 text-xs text-soya-ink/50">
      By continuing you acknowledge the
      <a href="/terms" class="underline hover:text-soya-accent">Preview Terms</a>
      and <a href="/privacy" class="underline hover:text-soya-accent">Privacy Notice</a>.
    </p>
  </section>
</Base>
