---
import Base from "../layouts/Base.astro";
---

<Base title="Sign in · SoyaOS Developer Portal">
  <section class="mx-auto max-w-md py-16 text-center">
    <h1 class="text-2xl font-semibold tracking-tight">Sign in</h1>
    <p class="mt-2 text-sm text-soya-ink/70">
      Authentication is not wired up yet. The GitHub OAuth flow lands in a
      later alpha drop — please come back after we cut <code>0.1.0-alpha.1</code>.
    </p>

    <button
      type="button"
      disabled
      class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md border border-soya-ink/15 bg-soya-ink/5 px-4 py-2.5 text-sm font-medium text-soya-ink/60"
    >
      <svg
        viewBox="0 0 16 16"
        aria-hidden="true"
        class="h-4 w-4 fill-current"
      >
        <path
          fill-rule="evenodd"
          d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      Continue with GitHub
    </button>

    <p class="mt-4 text-xs uppercase tracking-wider text-soya-accent/80">
      GitHub Sign-In coming soon
    </p>
  </section>
</Base>
