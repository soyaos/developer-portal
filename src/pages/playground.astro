---
import { Playground } from "../components/Playground";
import Base from "../layouts/Base.astro";
---

<Base title="Playground · SoyaOS Developer Portal">
  <section class="mb-8">
    <p class="text-xs uppercase tracking-[0.2em] text-soya-accent">Live inference</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Playground</h1>
    <p class="mt-2 max-w-3xl text-sm text-soya-ink/70">
      Call a SoyaOS Cloud model from your browser. Request content is sent to
      SoyaOS&apos;s Cloudflare Workers AI upstream for inference; SoyaOS retains only
      request metadata for 24 hours, not prompt or response bodies.
    </p>
  </section>

  <Playground client:load />
</Base>
