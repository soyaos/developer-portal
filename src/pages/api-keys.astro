---
import Base from "../layouts/Base.astro";
import { ApiKeysTable } from "../components/ApiKeysTable";
---

<Base title="API Keys · SoyaOS Developer Portal">
  <section class="mb-8">
    <p class="text-xs uppercase tracking-[0.2em] text-soya-accent">Manage</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">API keys</h1>
    <p class="mt-2 max-w-2xl text-sm text-soya-ink/70">
      Issue, rotate and revoke keys scoped to specific Agents. The raw key
      string is shown <em>once</em>, immediately after creation — make sure
      to copy it before closing the dialog.
    </p>
  </section>

  <ApiKeysTable client:load />
</Base>
