{
  "name": "@soyaos/developer-portal",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "SoyaOS Developer Portal — API Reference, Playground, API Keys, Webhook Debugger, Usage Dashboard.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:staging": "CLOUDFLARE_ENV=staging astro build",
    "preview": "astro preview",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "check": "wrangler types worker-configuration.d.ts && astro check",
    "lint": "astro check",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.worker.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "d1:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "preflight:production": "node scripts/preflight.mjs",
    "preflight:production:secrets": "node scripts/check-secret-names.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high && gitleaks git --no-banner --redact ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
