# SoyaOS Developer Portal — public build-time variables only.
#
# Copy to `.env.local` if you need to override these defaults. Never put OAuth
# credentials here; Cloudflare runtime secrets belong in `.dev.vars` locally
# and Worker Variables and Secrets in production.

# The portal currently fronts mock data; the layout shows a yellow alpha
# banner unless this is set to "false". Flip to "false" (or remove the
# variable) when the control plane RPC is wired in EPIC 6.
PUBLIC_ALPHA_MOCK=true
