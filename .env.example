# SoyaOS Developer Portal — example env file.
#
# Copy to `.env.local` and fill in real values. Never commit secrets.
# Variables prefixed with `PUBLIC_` are exposed to the browser; everything
# else is server-side only (SSR / edge functions).

# ---- GitHub OAuth ----
# Create an OAuth App at https://github.com/settings/developers and set the
# Authorization callback URL to:
#   http://localhost:4321/auth/github/callback   (dev)
#   https://developer.soyaos.ai/auth/github/callback  (prod)
PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Control plane ----
# Base URL of the SoyaOS control plane, consumed server-side by the OAuth
# callback handler when exchanging the GitHub `code` for a session token.
CONTROL_PLANE_URL=https://api.soyaos.ai

# ---- Alpha mock banner ----
# The portal currently fronts mock data; the layout shows a yellow alpha
# banner unless this is set to "false". Flip to "false" (or remove the
# variable) when the control plane RPC is wired in EPIC 6.
PUBLIC_ALPHA_MOCK=true
